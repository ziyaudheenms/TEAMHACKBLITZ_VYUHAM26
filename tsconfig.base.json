{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@bizcontext/types": ["./packages/types/src/index.ts"],
      "@bizcontext/database": ["./packages/database/src/index.ts"],
      "@bizcontext/auth": ["./packages/auth/src/index.ts"],
      "@bizcontext/permissions": ["./packages/permissions/src/index.ts"],
      "@bizcontext/ui": ["./packages/ui/src/index.ts"],
      "@bizcontext/agent-sdk": ["./packages/agent-sdk/src/index.ts"],
      "@bizcontext/integrations": ["./packages/integrations/src/index.ts"],
      "@bizcontext/validation": ["./packages/validation/src/index.ts"],
      "@bizcontext/module-meetings": ["./modules/meetings/src/index.ts"],
      "@bizcontext/module-tickets": ["./modules/tickets/src/index.ts"],
      "@bizcontext/module-notifications": ["./modules/notifications/src/index.ts"],
      "@bizcontext/module-agents": ["./modules/agents/src/index.ts"],
      "@bizcontext/module-analytics": ["./modules/analytics/src/index.ts"],
      "@bizcontext/module-communication": ["./modules/communication/src/index.ts"],
      "@bizcontext/module-employees": ["./modules/employees/src/index.ts"],
      "@bizcontext/module-knowledge": ["./modules/knowledge/src/index.ts"],
      "@bizcontext/module-organisations": ["./modules/organisations/src/index.ts"],
      "@bizcontext/module-projects": ["./modules/projects/src/index.ts"],
      "@bizcontext/module-storage": ["./modules/storage/src/index.ts"],
      "@bizcontext/module-tasks": ["./modules/tasks/src/index.ts"]
    }
  }
}
