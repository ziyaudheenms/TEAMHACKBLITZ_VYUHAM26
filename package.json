{
  "name": "bizcontext-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "modules/*", "workers/*"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "start:api": "bun apps/api/src/index.ts",
    "lint": "oxlint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.0",
    "oxlint": "^0.15.11",
    "postgres": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
